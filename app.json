{
  "expo": {
    "name": "Ballast",
    "slug": "ballast",
    "version": "1.0.0",
    "scheme": "ballast",
    "orientation": "portrait",
    "icon": "./release/creo/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./release/creo/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F3F6FA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ballast.app"
    },
    "android": {
      "package": "com.ballast.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./release/creo/adaptive-foreground.png",
        "backgroundColor": "#EFE7FD"
      },
      "predictiveBackGestureEnabled": false,
      "_comment_blockedPermissions": "Ballast: only POST_NOTIFICATIONS (optional daily weigh-in reminder, opt-in, inexact trigger; RECEIVE_BOOT_COMPLETED keeps it after a reboot) and VIBRATE. INTERNET and SYSTEM_ALERT_WINDOW blocked — everything is computed on the device.",
      "blockedPermissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.READ_SMS",
        "android.permission.READ_CALL_LOG",
        "android.permission.QUERY_ALL_PACKAGES",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#176CD3"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
